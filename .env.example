# ATENÇÃO: este arquivo é VERSIONADO — nunca coloque valor real aqui (secret, client
# id/secret, senha). Valores reais vão só em `.env` (com ponto, gitignored).

#--------------------------------------------------------------------
# .env.example — específico deste projeto (devfinder-codeigniter)
#
# Diferente de `env` (template genérico do CodeIgniter 4, todas as chaves comentadas): este
# arquivo já vem preenchido com os valores padrão do Docker Compose local (ver
# docker-compose.yml/README.md) — só copiar pra `.env` e preencher as credenciais do GitHub
# OAuth App pra ter o ambiente de dev completo. `cp .env.example .env`.
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'http://localhost:8081/'

#--------------------------------------------------------------------
# DATABASE
#
# Ponto único de troca de ambiente — ver app/Config/Database.php ($defaultGroup). Valores
# possíveis: default (docker env local, valor padrão) | tidbcloud (TiDB Cloud staging, ver
# specs/deploy/fase-7-deploy-mysql.md, seção "TiDB Cloud") | dockerprod (self-host GCP/Oracle,
# ainda não provisionado — specs/deploy/fase-7-deploy-mysql-gcp.md). Deixar comentado usa o
# fallback 'default' já fixado em app/Config/Database.php (mesmo valor que o CI usa).
# database.defaultGroup = default
#--------------------------------------------------------------------

# --- docker env local (valores do serviço `mysql` do docker-compose.yml) ---
database.default.hostname = mysql
database.default.database = devfinder
database.default.username = devfinder
database.default.password = devfinder
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_0900_ai_ci

# --- tidbcloud env staging — preencher com as credenciais reais da sua instância TiDB Cloud
# (TiDB Cloud console → Connect). TLS/CA já ficam fixados em app/Config/Database.php, não
# precisam de chave aqui. ---
# database.tidbcloud.hostname =
# database.tidbcloud.database = devfinder
# database.tidbcloud.username =
# database.tidbcloud.password =
# database.tidbcloud.port = 4000

# --- dockerprod — self-host GCP/Oracle, decisão de provedor ainda pendente (plan.md, item
# 7.5). Preencher quando provisionar. ---
# database.dockerprod.hostname =
# database.dockerprod.database = devfinder
# database.dockerprod.username =
# database.dockerprod.password =
# database.dockerprod.port = 3306

# database.tests.* — CIUnit (Fase 7). devfinder_test já é criado pelo
# docker/mysql/init.sql, mesmo servidor MySQL, banco separado do de desenvolvimento.
database.tests.hostname = mysql
database.tests.database = devfinder_test
database.tests.username = devfinder
database.tests.password = devfinder
database.tests.DBDriver = MySQLi
database.tests.DBPrefix =
database.tests.charset = utf8mb4
database.tests.DBCollat = utf8mb4_0900_ai_ci
database.tests.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION — gerar um valor próprio, não usar este de exemplo
#--------------------------------------------------------------------

encryption.key = hex2bin:0000000000000000000000000000000

#--------------------------------------------------------------------
# AUTH (GitHub OAuth + JWT — Fase 4)
#
# auth.jwtSecret: qualquer string aleatória sua, gerar com
#   openssl rand -hex 32
# auth.githubClientId / githubClientSecret: de um GitHub OAuth App real
#   (github.com/settings/developers), Authorization callback URL =
#   {app.baseURL}v1/auth/github/callback
#--------------------------------------------------------------------

auth.jwtSecret = troque-por-um-valor-aleatorio-seu
auth.jwtExpirySeconds = 604800
auth.githubClientId =
auth.githubClientSecret =
auth.webURL = http://localhost:3000

#--------------------------------------------------------------------
# VIDEO REFRESH (ingestão em lote — Fase 6)
#
# videorefresh.jsonbinApiKey / jsonbinIdSubs: credenciais do bin em jsonbin.io que alimenta
# `php spark video:refresh` e `POST /video/refresh` — mesmo bin já usado pelo devfinder-api
# original (ver ../devfinder-api/.env, X-Master-Key / bin id — mesmas duas variáveis, mesmo
# valor, pode reaproveitar). Sem essas duas, o comando roda com 0 candidatos, sem erro.
#--------------------------------------------------------------------

videorefresh.jsonbinApiKey =
videorefresh.jsonbinIdSubs =
