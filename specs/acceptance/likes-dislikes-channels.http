### POST /likes/channels/{username} — alvo inexistente
# Esperado: 400, {"error":"Channel not exists"}. `username` aqui e sempre um channel.name
# (achado #3 de specs/fase-5-escrita-relacionamentos.md), resolvido via slugify.
POST {{baseUrl}}/likes/channels/no-such-channel-zzz
Authorization: Bearer {{authToken}}

### POST /likes/channels/{username} — follow de um canal real do seed
# Esperado: 200, Dev autenticado com "rocketseat" (slug) em follow.
POST {{baseUrl}}/likes/channels/Rocketseat
Authorization: Bearer {{authToken}}

### DELETE /likes/channels/{username} — unfollow
# Esperado: 200, Dev autenticado sem "rocketseat" em follow (idempotente).
DELETE {{baseUrl}}/likes/channels/Rocketseat
Authorization: Bearer {{authToken}}

### POST /dislikes/channels/{username} — alvo inexistente
# Esperado: 400, {"error":"Channel not exists"}.
POST {{baseUrl}}/dislikes/channels/no-such-channel-zzz
Authorization: Bearer {{authToken}}

### POST /dislikes/channels/{username} — ignore de um canal real do seed
# Esperado: 200, Dev autenticado com "201-front-end" (slug) em ignore. Nome com hifen
# ("201 Front-End") testa o slugify por completo, nao so espacos.
POST {{baseUrl}}/dislikes/channels/201%20Front-End
Authorization: Bearer {{authToken}}

### DELETE /dislikes/channels/{username} — un-ignore
# Esperado: 200, Dev autenticado sem "201-front-end" em ignore.
DELETE {{baseUrl}}/dislikes/channels/201%20Front-End
Authorization: Bearer {{authToken}}
