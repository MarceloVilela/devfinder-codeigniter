### POST /likes/devs/{username} — alvo inexistente
# Esperado: 400, {"error":"Dev not exists"}.
POST {{baseUrl}}/likes/devs/no-such-dev-zzz
Authorization: Bearer {{authToken}}

### POST /likes/devs/{username} — alvo existente (dev real do seed)
# Esperado: 200, Dev autenticado com "akitaonrails" em likes (UpdateItem ADD, idempotente).
POST {{baseUrl}}/likes/devs/akitaonrails
Authorization: Bearer {{authToken}}

### GET /likes/devs — devs no Set `likes` do autenticado
# Esperado: 200, array de Dev incluindo "akitaonrails", nunca o proprio autenticado (achado
# #12 de specs/fase-5-escrita-relacionamentos.md).
GET {{baseUrl}}/likes/devs
Authorization: Bearer {{authToken}}

### DELETE /likes/devs/{username} — remove o like
# Esperado: 200, Dev autenticado sem "akitaonrails" em likes (UpdateItem DELETE, idempotente
# — repetir a chamada continua 200).
DELETE {{baseUrl}}/likes/devs/akitaonrails
Authorization: Bearer {{authToken}}

### POST /dislikes/devs/{username} — alvo inexistente
# Esperado: 400, {"error":"Dev not exists"}.
POST {{baseUrl}}/dislikes/devs/no-such-dev-zzz
Authorization: Bearer {{authToken}}

### POST /dislikes/devs/{username} — alvo existente
# Esperado: 200, Dev autenticado com "akitaonrails" em deslikes.
POST {{baseUrl}}/dislikes/devs/akitaonrails
Authorization: Bearer {{authToken}}

### GET /dislikes/devs
# Esperado: 200, array de Dev incluindo "akitaonrails".
GET {{baseUrl}}/dislikes/devs
Authorization: Bearer {{authToken}}

### DELETE /dislikes/devs/{username} — remove o dislike
# Esperado: 200, Dev autenticado sem "akitaonrails" em deslikes.
DELETE {{baseUrl}}/dislikes/devs/akitaonrails
Authorization: Bearer {{authToken}}
